{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBV Teleprompter",
  "version": "0.2.1",
  "identifier": "com.davidbuenov.dbv-teleprompter",
  "build": {
    "beforeDevCommand": "npm run sync:frontend",
    "beforeBuildCommand": "npm run sync:frontend",
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DBV Teleprompter",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
